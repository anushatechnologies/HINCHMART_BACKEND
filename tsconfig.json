{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2022",
    "target": "ES2022",
    "verbatimModuleSyntax": false,
    "isolatedModules": false,
    "exactOptionalPropertyTypes": false,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"]
}
