  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_inquiries")
}

// ================= PHASE 12: CORPORATE CREDIT & PO APPROVALS ================= //

model BuyerCreditLine {
  id                   Int      @id @default(autoincrement())
  companyId            Int?     @map("company_id")
  userId               Int      @map("user_id")
  requestedCreditLimit Decimal  @map("requested_credit_limit") @db.Decimal(12, 2)
  approvedCreditLimit  Decimal  @default(0.00) @map("approved_credit_limit") @db.Decimal(12, 2)
  usedCreditLimit      Decimal  @default(0.00) @map("used_credit_limit") @db.Decimal(12, 2)
  paymentTermsDays     Int      @default(30) @map("payment_terms_days")
  creditStatus         String   @default("PENDING") @map("credit_status")
  gstin                String?
  panNumber            String?  @map("pan_number")
  financialDocUrl      String?  @map("financial_doc_url")
  adminNotes           String?  @map("admin_notes") @db.Text
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("buyer_credit_lines")
}

model PurchaseOrderApproval {
  id            Int      @id @default(autoincrement())
  poNumber      String   @unique @map("po_number")
  companyId     Int?     @map("company_id")
  requesterId   Int      @map("requester_id")
  approverId    Int?     @map("approver_id")
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  status        String   @default("PENDING_APPROVAL")
  remarks       String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  requester User  @relation("PORequester", fields: [requesterId], references: [id], onDelete: Cascade)
  approver  User? @relation("POApprover", fields: [approverId], references: [id], onDelete: SetNull)
  @@map("purchase_order_approvals")
}

// ================= PHASE 7: CONTENT & SYSTEM ================= //

model PageContent {
  id        Int      @id @default(autoincrement())
  slug      String   @unique // e.g., 'privacy-policy', 'terms', 'about'
  title     String
  content   String   @db.LongText
  isActive  Boolean  @default(true) @map("is_active")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("page_contents")
}

// ================= PHASE 13: ESCROW & TAX COMPLIANCE ================= //

model EscrowHold {
  id               Int      @id @default(autoincrement())
  vendorId         Int      @map("vendor_id")
  orderId          Int      @map("order_id")
  grossAmount      Decimal  @map("gross_amount") @db.Decimal(10, 2)
  commissionAmount Decimal  @map("commission_amount") @db.Decimal(10, 2)
  tdsAmount        Decimal  @map("tds_amount") @db.Decimal(10, 2) // e.g., 1% TDS u/s 194O
  tcsAmount        Decimal  @map("tcs_amount") @db.Decimal(10, 2) // e.g., 1% GST TCS
  netPayoutAmount  Decimal  @map("net_payout_amount") @db.Decimal(10, 2)
  holdUntilDate    DateTime @map("hold_until_date")
  escrowStatus     String   @default("HELD") @map("escrow_status") // HELD, RELEASED, REFUNDED, DISPUTED
  payoutBatchId    String?  @map("payout_batch_id")
  createdAt        DateTime @default(now()) @map("created_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("escrow_holds")
}

model TaxCertificate {
  id               Int      @id @default(autoincrement())
  vendorId         Int      @map("vendor_id")
  quarter          String   // e.g., "Q1", "Q2"
  financialYear    String   @map("financial_year") // e.g., "2023-2024"
  totalGstTcs      Decimal  @map("total_gst_tcs") @db.Decimal(12, 2)
  totalTdsDeducted Decimal  @map("total_tds_deducted") @db.Decimal(12, 2)
  certificateUrl   String   @map("certificate_url")
  createdAt        DateTime @default(now()) @map("created_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("tax_certificates")
}

// ================= B2B MULTI-DEVICE BANNER MANAGEMENT ================= //

model Banner {
  id              Int       @id @default(autoincrement())
  title           String
  subtitle        String?
  bannerType      String    @default("HERO_SLIDER") @map("banner_type")
  position        String    @default("HOMEPAGE_TOP")
  deviceTarget    String    @default("ALL") @map("device_target")
  desktopImageUrl String?   @map("desktop_image_url")
  tabletImageUrl  String?   @map("tablet_image_url")
  mobileImageUrl  String?   @map("mobile_image_url")
  imageUrl        String    @map("image_url")
  linkUrl         String?   @map("link_url")
  ctaText         String?   @map("cta_text")
  categorySlug    String?   @map("category_slug")
  brandSlug       String?   @map("brand_slug")
  couponCode      String?   @map("coupon_code")
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  priority        Int       @default(1)
  sortOrder       Int       @default(0) @map("sort_order")
  isActive        Boolean   @default(true) @map("is_active")
  targetAudience  String    @default("ALL") @map("target_audience")
  views           Int       @default(0)
  clicks          Int       @default(0)
  ctr             Float     @default(0.0)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("banners")
}
