# HinchMart Backend Environment Configuration Example

PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/hinchmart?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="your_production_jwt_access_secret_key_here"
JWT_REFRESH_SECRET="your_production_jwt_refresh_secret_key_here"
JWT_SECRET="your_production_jwt_secret_key_here"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="o571jfo7"
CLOUDINARY_API_KEY="133869837249733"
CLOUDINARY_API_SECRET="ufERhfAC9WvtRoUqe8DIUCgeXug"

# AWS S3 Storage Configuration (For Videos, Heavy PDFs & Documents)
AWS_ACCESS_KEY_ID="AKIAXXXXXXXXXXXXXXXX"
AWS_SECRET_ACCESS_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET_NAME="hinchmart-media-storage"

# Upload Directory
UPLOAD_DIR="./uploads"
